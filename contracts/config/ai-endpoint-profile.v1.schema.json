{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-auto-trade.invalid/contracts/config/ai-endpoint-profile.v1.schema.json",
  "title": "Approved AI endpoint profile v1",
  "description": "Security-owned outbound endpoint profile. It is never user input and contains approved host/SNI and route policy, not an arbitrary URL or credential.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "endpoint_profile_id", "status", "network_route_id", "network_zone", "approved_hostnames", "approved_tls_server_names", "https_port", "redirect_policy", "dns_resolution_policy", "private_address_policy", "approval_evidence_ref"],
  "properties": {
    "profile_version": { "const": 1 },
    "endpoint_profile_id": { "$ref": "#/$defs/identifier" },
    "status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "SUSPENDED", "RETIRED"] },
    "network_route_id": { "$ref": "#/$defs/identifier", "description": "Approved egress-gateway/network-route identifier; it is not a client-supplied proxy URL." },
    "network_zone": { "type": "string", "enum": ["PUBLIC_INTERNET", "APPROVED_PRIVATE_GATEWAY"] },
    "approved_hostnames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hostname" } },
    "approved_tls_server_names": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hostname" } },
    "https_port": { "const": 443 },
    "redirect_policy": { "const": "DENY" },
    "dns_resolution_policy": { "const": "EGRESS_GATEWAY_ONLY" },
    "private_address_policy": { "type": "string", "enum": ["DENY", "APPROVED_PRIVATE_ROUTE_ONLY"] },
    "approval_evidence_ref": { "type": "string", "minLength": 1, "maxLength": 2048 }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "hostname": { "type": "string", "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$" }
  }
}
