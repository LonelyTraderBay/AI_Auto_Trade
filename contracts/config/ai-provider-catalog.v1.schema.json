{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-auto-trade.invalid/contracts/config/ai-provider-catalog.v1.schema.json",
  "title": "AI provider and model catalog v1",
  "description": "Approved provider/model capability catalog for Phase 6. It contains no API key, raw endpoint URL or credential reference and does not authorize a provider runtime by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "catalog_id", "status", "created_at", "entries"],
  "properties": {
    "catalog_version": { "const": 1 },
    "catalog_id": { "$ref": "#/$defs/uuid_v7" },
    "status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "RETIRED"] },
    "created_at": { "$ref": "#/$defs/date_time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider_entry" }
    }
  },
  "$defs": {
    "uuid_v7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "date_time": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "provider_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "display_name",
        "adapter_id",
        "adapter_version",
        "adapter_artifact_digest",
        "endpoint_profile_id",
        "lifecycle_status",
        "auth_mode",
        "allowed_environments",
        "data_egress_class",
        "data_residency_class",
        "retention_training_policy_ref",
        "capabilities",
        "models",
        "approval_evidence_ref"
      ],
      "properties": {
        "provider_id": { "$ref": "#/$defs/identifier" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter_id": { "$ref": "#/$defs/identifier" },
        "adapter_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
        "adapter_artifact_digest": { "$ref": "#/$defs/sha256", "description": "Pinned reviewed adapter artifact/source digest. A new digest requires capability/security review and a new catalog version." },
        "endpoint_profile_id": { "$ref": "#/$defs/identifier", "description": "Approved opaque endpoint profile ID, never a URL supplied by an end user." },
        "lifecycle_status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "SUSPENDED", "RETIRED"] },
        "auth_mode": { "const": "API_KEY", "description": "BYOK v1 supports only API-key provider profiles. Workload identity requires a separately approved credential-flow contract and is not enrollable here." },
        "allowed_environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["paper", "testnet", "canary", "live"] }
        },
        "data_egress_class": { "type": "string", "enum": ["SANITIZED_PROPOSAL_ONLY", "PRIVATE_GATEWAY_ONLY"] },
        "data_residency_class": { "type": "string", "minLength": 1, "maxLength": 128 },
        "retention_training_policy_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structured_generation", "embeddings", "provider_idempotency", "tool_calling_allowed"],
          "properties": {
            "structured_generation": { "type": "boolean" },
            "embeddings": { "type": "boolean" },
            "provider_idempotency": { "type": "boolean" },
            "tool_calling_allowed": { "const": false }
          }
        },
        "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/model_entry" } },
        "approval_evidence_ref": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "model_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_revision", "lifecycle_status", "structured_output_supported", "max_input_tokens", "max_output_tokens"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "lifecycle_status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "DEPRECATED", "RETIRED"] },
        "structured_output_supported": { "type": "boolean" },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
