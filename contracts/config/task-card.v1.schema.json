{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-auto-trade.invalid/contracts/config/task-card.v1.schema.json",
  "title": "AI Auto Trade Task Card v1",
  "description": "Machine-readable task authority defined exactly by master Appendix C.3 and §16.2. A valid card does not by itself approve a task or gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "phase",
    "status",
    "owner",
    "reviewer",
    "expiry_at",
    "branch_pattern",
    "references",
    "goal",
    "non_goals",
    "preconditions",
    "blockers",
    "allowed_globs",
    "forbidden_globs",
    "impact",
    "acceptance_criteria",
    "required_commands",
    "evidence_path",
    "gate_impact",
    "rollback_or_forward_fix",
    "known_risks",
    "waiver_id"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+){0,2}$",
      "description": "Phase/task identifier, for example 0.0.4 or 0.1."
    },
    "phase": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "description": "Roadmap phase, for example 0.0 or 3."
    },
    "status": {
      "type": "string",
      "enum": ["READY", "IN_PROGRESS", "REVIEW", "DONE", "BLOCKED"]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "expiry_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp; CI rejects expired task cards."
    },
    "branch_pattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s]+$",
      "description": "Pattern consumed by CI to bind a branch/PR to this task."
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "adrs", "contracts"],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:FR|NFR|SEC)-[A-Z0-9]+-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "adrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ADR-[0-9]{4}$"
          },
          "uniqueItems": true
        },
        "contracts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Canonical path or contract ID from docs/backend/contracts/contract-registry.md."
        }
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_globs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbidden_globs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Forbidden paths override allowed_globs."
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "api", "event", "config", "dependency", "security"],
      "properties": {
        "database": { "type": "boolean" },
        "api": { "type": "boolean" },
        "event": { "type": "boolean" },
        "config": { "type": "boolean" },
        "dependency": { "type": "boolean" },
        "security": { "type": "boolean" }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_path": {
      "type": "string",
      "pattern": "^docs/governance/evidence/(?:tasks|gates)/.+/$",
      "description": "Repository-relative evidence directory with trailing slash."
    },
    "gate_impact": {
      "type": "string",
      "minLength": 1,
      "description": "none or the named phase/gate affected by this task."
    },
    "rollback_or_forward_fix": {
      "type": "string",
      "minLength": 1
    },
    "known_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "waiver_id": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^WAIVER-[0-9]{4,}$" }
      ],
      "description": "Safety invariants cannot be waived; null means no waiver."
    }
  }
}
