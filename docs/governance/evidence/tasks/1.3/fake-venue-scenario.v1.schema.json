{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-auto-trade.invalid/drafts/fake-venue-scenario.v1.schema.json",
  "title": "Task 1.3 Fake Venue Scenario Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "scenario_revision", "seed", "clock_start", "outcomes"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "scenario_revision": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer", "minimum": 0},
    "clock_start": {"type": "string", "format": "date-time"},
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "outcome"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "delay_ms": {"type": "integer", "minimum": 0, "default": 0},
          "outcome": {
            "type": "string",
            "enum": ["ACCEPTED", "REJECTED", "PARTIAL_FILL", "FILLED", "CANCELLED", "TIMEOUT", "UNKNOWN"]
          },
          "fault_code": {"type": ["string", "null"]},
          "venue_order_id": {"type": ["string", "null"]},
          "fills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["price", "quantity"],
              "properties": {
                "price": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
                "quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
                "fee_amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
                "fee_asset": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
